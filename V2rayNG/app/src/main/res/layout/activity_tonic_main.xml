<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:fitsSystemWindows="true">

    <!-- ===================== Top bar ===================== -->
    <TextView
        android:id="@+id/tvBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="@string/app_name"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:letterSpacing="0.12"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/btnLogout"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/tonic_ic_logout"
        android:contentDescription="@string/tonic_logout"
        app:layout_constraintTop_toTopOf="@id/tvBrand"
        app:layout_constraintBottom_toBottomOf="@id/tvBrand"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btnRefresh"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/tonic_ic_refresh"
        android:contentDescription="@string/tonic_refresh"
        app:layout_constraintTop_toTopOf="@id/tvBrand"
        app:layout_constraintBottom_toBottomOf="@id/tvBrand"
        app:layout_constraintEnd_toStartOf="@id/btnLogout" />

    <!-- ===================== Connect button ===================== -->
    <View
        android:id="@+id/connectRing"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:background="@drawable/tonic_connect_ring"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.42" />

    <FrameLayout
        android:id="@+id/btnConnect"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/tonic_connect_circle"
        android:backgroundTint="@color/brand_disconnected"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toTopOf="@id/connectRing"
        app:layout_constraintBottom_toBottomOf="@id/connectRing"
        app:layout_constraintStart_toStartOf="@id/connectRing"
        app:layout_constraintEnd_toEndOf="@id/connectRing">

        <ImageView
            android:id="@+id/ivPower"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:src="@drawable/tonic_ic_power"
            android:contentDescription="@string/tonic_tap_to_connect" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/tonic_disconnected"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/connectRing"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSubStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/tonic_status_disconnected"
        android:textColor="#99FFFFFF"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===================== Location row ===================== -->
    <LinearLayout
        android:id="@+id/layoutLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:background="@drawable/tonic_surface_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="18dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tonic_current_location"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tonic_auto_fastest"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/brand_connected"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/tonic_ic_chevron"
            android:contentDescription="@string/tonic_choose_location" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
